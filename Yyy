-- โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€ เน€เธเธดเธ”/เธเธดเธ”เน€เธกเธเธน (เธเธธเนเธกเธงเธเธเธฅเธกเธฅเธญเธข + เธเธธเนเธกเธฅเธฑเธ” RightCtrl) โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€
local menuOpen = true
local function setMenu(open)
    menuOpen = open
    if open then
        mainFrame.Visible = true
        mainFrame.Size = UDim2.new(0, 20, 0, 20)
        mainFrame.Position = UDim2.new(0.5, -10, 0.5, -10)
        playTween(mainFrame, 0.3, Enum.EasingStyle.Back, {
            Size = MENU_SIZE, Position = MENU_POSITION,
        })
    else
        local t = playTween(mainFrame, 0.16, Enum.EasingStyle.Quad, {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0.5, -10, 0.5, -10),
        })
        t.Completed:Connect(function()
            if not menuOpen then
                mainFrame.Visible = false
            end
        end)
    end
end

onClick(floatingBtn, function()
    if dragMoved then
        dragMoved = false
        return
    end
    setMenu(not menuOpen)
end)

-- เธเธธเนเธกเธฅเธฑเธ”เธเธตเธขเนเธเธญเธฃเนเธ”: RightControl เน€เธเธดเธ”/เธเธดเธ”เน€เธกเธเธน (เธเนเนเธ”เนเธเธเธกเธทเธญเธ–เธทเธญเธเนเธฒเธเธเธธเนเธกเธฅเธญเธข)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not screenGui.Parent then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        setMenu(not menuOpen)
    end
end)

