local function tryLogin()
    if passBox.Text == PASSWORD then
        isLoggedIn = true
        loginContainer.Visible = false
        playTween(mainFrame, 0.25, Enum.EasingStyle.Back, {
            Size = MENU_SIZE, Position = MENU_POSITION,
        })
        showTab(1)
        invalidateCaches()
        refreshPlayerList()
        refreshDetail()
    else
        passBox.Text = ""
        passBox.PlaceholderText = "โ เธฃเธซเธฑเธชเธเนเธฒเธเนเธกเนเธ–เธนเธเธ•เนเธญเธ!"
        -- เธชเธฑเนเธเน เธ•เธญเธเธเธดเธกเธเนเธเธดเธ”
        for _, off in ipairs({ -8, 8, -5, 5, 0 }) do
            loginContainer.Position = UDim2.new(0, 50 + off, 0, 45)
            task.wait(0.04)
        end
    end
end
onClick(submitBtn, tryLogin)
