local pages   = { page1, page2, page3 }
local tabBtns = { tabBtn1, tabBtn2, tabBtn3 }
local function showTab(n)
    if not isLoggedIn then return end
    for i, pg in ipairs(pages) do
        pg.Visible = (i == n)
    end
    for i, b in ipairs(tabBtns) do
        b.BackgroundColor3 = (i == n) and C.accent or C.side
    end
end
onClick(tabBtn1, function() showTab(1) end)
onClick(tabBtn2, function() showTab(2) end)
onClick(tabBtn3, function() showTab(3) end)

